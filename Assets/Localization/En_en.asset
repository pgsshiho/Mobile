  - m_Id: 60616236727762944
    m_Localized: Leaving
    m_Metadata:
      m_Items: []
  - m_Id: 60616699497906176
    m_Localized: 'It''s dirty water.

'
    m_Metadata:
      m_Items: []
  - m_Id: 60616597412741120
    m_Localized: There's a fountain. It looks like I can wash my machine here.
    m_Metadata:
      m_Items: []
  - m_Id: 60664080838918144
    m_Localized: 'Reduces instability to increase accuracy.

      accurary + 5'
    m_Metadata:
      m_Items: []
  - m_Id: 60664083732987904
    m_Localized: 'Equip gloves to increase your maximum health.

      MaxHP + 10'
    m_Metadata:
      m_Items: []
  - m_Id: 60664084936753152
    m_Localized: 'Equip a booster to your weapon to increase its attack power.

      Attack
      Power + 5'
