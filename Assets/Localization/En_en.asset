    m_Metadata:
      m_Items: []
  - m_Id: 42894728614084608
    m_Localized: 'You can move to the room in that direction by clicking the arrow
      shown nearby.

'
    m_Metadata:
      m_Items: []
  - m_Id: 43611436949667840
