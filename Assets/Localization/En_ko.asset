  - m_Id: 4613747474432
    m_Localized: 'The world has '
    m_Metadata:
      m_Items: []
  - m_Id: 41015848047443968
    m_Localized: "\uC804\uB825\uC774 \uB098\uAC04\uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 42894728614084608
    m_Localized: "\uC606\uC5D0 \uBCF4\uC774\uB294 \uD654\uC0B4\uD45C\uB97C \uD074\uB9AD\uD558\uBA74
      \uADF8\uBC29\uD5A5\uC758 \uBC29\uC73C\uB85C \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43611436949667840
    m_Localized: "1~2\uC5F4\uC758 \uC801\uC744 30\uB370\uBBF8\uC9C0\uB85C \uACF5\uACA9\uD55C\uB2E4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43906713262718976
    m_Localized: "\uB300\uC7A5\uAC04\uC5D0 \uC5B4\uC11C\uC624\uC2DC\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 55514236658876416
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 1"
    m_Metadata:
      m_Items: []
  - m_Id: 55514257592647680
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 55514267046608896
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 3"
    m_Metadata:
      m_Items: []
  - m_Id: 55910292961853440
    m_Localized: "\uD55C\uBC88 \uC81C\uAC70 \uD558\uC2DC\uBA74 \uB418\uB3CC\uB9AC\uC2E4
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 55931906613018624
    m_Localized: "\uC0AD\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 55931970366439424
    m_Localized: "\uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 56276386583117824
    m_Localized: "\uC606\uC5D0 \uBCF4\uC774\uB294 \uD654\uC0B4\uD45C\uB97C \uD074\uB9AD\uD558\uBA74
      \uADF8\uBC29\uD5A5\uC758 \uBC29\uC73C\uB85C \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 56314693711003648
    m_Localized: "\uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uBA74 \uB3C4\uB9DD\uAC08
      \uC218 \uC5C6\uC73C\uBA70 \uBC11\uC5D0 \uB098\uC628 \uC2A4\uD0AC\uB4E4\uC744
      \uD65C\uC6A9\uD558\uC5EC \uC801\uC744 \uBAA8\uB450 \uBB3C\uB9AC\uCCD0\uC57C
      \uD569\uB2C8\uB2E4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 56493937409884160
    m_Localized: "\uAC01 \uC2A4\uD0AC\uC740 \uC0AC\uC6A9\uAC00\uB2A5\uD55C \uC704\uCE58\uC640
      \uACF5\uACA9\uAC00\uB2A5\uD55C \uC704\uCE58\uAC00 \uAC01\uC790 \uC788\uC73C\uB2C8
      \uC8FC\uC758\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 56494019131703296
    m_Localized: "\uD30C\uD2F0 \uC778\uC6D0\uC218\uAC00 \uC99D\uAC00\uD558\uAC8C
      \uB41C\uB2E4\uBA74 \uACF5\uACA9 \uAC00\uB2A5 \uC704\uCE58\uB85C \uC774\uB3D9\uD574\uC57C
      \uD569\uB2C8\uB2E4.\n\uC774 \uBC84\uD2BC\uC744 \uB204\uB978\uB4A4 \uC704\uCE58\uB97C
      \uB204\uB974\uBA74 \uC774\uB3D9\uD569\uB2C8\uB2E4. \n\uAC01 \uC720\uB2DB\uBCC4\uB85C
      \uC774\uB3D9\uC81C\uD55C\uC774 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
