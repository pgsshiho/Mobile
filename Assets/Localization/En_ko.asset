  m_TableData:
  - m_Id: 4613747474432
    m_Localized: 'The world has '
    m_Metadata:
      m_Items: []
  - m_Id: 41015848047443968
    m_Localized: "\uC804\uB825\uC774 \uB098\uAC04\uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 42894728614084608
    m_Localized: "\uC606\uC5D0 \uBCF4\uC774\uB294 \uD654\uC0B4\uD45C\uB97C \uD074\uB9AD\uD558\uBA74
      \uADF8\uBC29\uD5A5\uC758 \uBC29\uC73C\uB85C \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43611436949667840
    m_Localized: "1~2\uC5F4\uC758 \uC801\uC744 30\uB370\uBBF8\uC9C0\uB85C \uACF5\uACA9\uD55C\uB2E4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43906713262718976
    m_Localized: "\uB300\uC7A5\uAC04\uC5D0 \uC5B4\uC11C\uC624\uC2DC\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 55514236658876416
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 1"
    m_Metadata:
      m_Items: []
  - m_Id: 55514257592647680
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 55514267046608896
    m_Localized: "\uC138\uC774\uBE0C \uD30C\uC77C 3"
    m_Metadata:
      m_Items: []
  - m_Id: 55910292961853440
    m_Localized: "\uD55C\uBC88 \uC81C\uAC70 \uD558\uC2DC\uBA74 \uB418\uB3CC\uB9AC\uC2E4
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 55931906613018624
    m_Localized: "\uC0AD\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 55931970366439424
    m_Localized: "\uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 56276386583117824
    m_Localized: "\uC606\uC5D0 \uBCF4\uC774\uB294 \uD654\uC0B4\uD45C\uB97C \uD074\uB9AD\uD558\uBA74
      \uADF8\uBC29\uD5A5\uC758 \uBC29\uC73C\uB85C \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 56314693711003648
    m_Localized: "\uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uBA74 \uB3C4\uB9DD\uAC08
      \uC218 \uC5C6\uC73C\uBA70 \uBC11\uC5D0 \uB098\uC628 \uC2A4\uD0AC\uB4E4\uC744
      \uD65C\uC6A9\uD558\uC5EC \uC801\uC744 \uBAA8\uB450 \uBB3C\uB9AC\uCCD0\uC57C
      \uD569\uB2C8\uB2E4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 56493937409884160
    m_Localized: "\uAC01 \uC2A4\uD0AC\uC740 \uC0AC\uC6A9\uAC00\uB2A5\uD55C \uC704\uCE58\uC640
      \uACF5\uACA9\uAC00\uB2A5\uD55C \uC704\uCE58\uAC00 \uAC01\uC790 \uC788\uC73C\uB2C8
      \uC8FC\uC758\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 56494019131703296
    m_Localized: "\uD30C\uD2F0 \uC778\uC6D0\uC218\uAC00 \uC99D\uAC00\uD558\uAC8C
      \uB41C\uB2E4\uBA74 \uACF5\uACA9 \uAC00\uB2A5 \uC704\uCE58\uB85C \uC774\uB3D9\uD574\uC57C
      \uD569\uB2C8\uB2E4.\n\uC774 \uBC84\uD2BC\uC744 \uB204\uB978\uB4A4 \uC704\uCE58\uB97C
      \uB204\uB974\uBA74 \uC774\uB3D9\uD569\uB2C8\uB2E4. \n\uAC01 \uC720\uB2DB\uBCC4\uB85C
      \uC774\uB3D9\uC81C\uD55C\uC774 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 56663110379339776
    m_Localized: "\uBE44\uC0C1 \uC804\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 56663934077730816
    m_Localized: "\uACF5\uACA9\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 56670912963379200
    m_Localized: "\uBC29\uC5B4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 56675404429623296
    m_Localized: "\uD2B9\uC218 \uBC29\uC5B4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 56675567915204608
    m_Localized: "\uCE58\uBA85\uD0C0\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 56675630603272192
    m_Localized: "\uBA85\uC911\uB960"
    m_Metadata:
      m_Items: []
  - m_Id: 56675683891904512
    m_Localized: "\uD68C\uD53C\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 56675765097824256
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 56855418970275840
    m_Localized: "\uB0A8\uC740 \uCE58\uC720\uAC00\uB2A5 \uD69F\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 57958859838816256
    m_Localized: "\uC800\uC7A5 \uB370\uC774\uD130\uB97C \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 58130363041939456
    m_Localized: "\uC0AC\uC6A9\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 58130364564471808
    m_Localized: "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 58130388073545728
    m_Localized: "\uBC30\uACBD\uC74C\uC545"
    m_Metadata:
      m_Items: []
  - m_Id: 58324579248472064
    m_Localized: "\uD6A8\uACFC\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 58324600362598400
    m_Localized: "\uB9C8\uC2A4\uD130 \uBCFC\uB968"
    m_Metadata:
      m_Items: []
  - m_Id: 60498846958452736
    m_Localized: "\uCC3E\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60498926583119872
    m_Localized: "\uB5A0\uB09C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60499077208965120
    m_Localized: "\uBB34\uB108\uC9C4 \uAC74\uBB3C\uC774 \uC788\uB2E4. \uC4F8\uB9CC\uD55C
      \uC7A5\uBE44\uB97C \uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4. \n\uD558\uC9C0\uB9CC
      \uBB34\uB108\uC838 \uB0B4\uB9B4 \uC218\uB3C4 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 60499501198573568
    m_Localized: "\uB354 \uC774\uC0C1 \uC4F8\uBAA8 \uC788\uC5B4 \uBCF4\uC774\uB294
      \uAC74 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 60501276714565632
    m_Localized: "\uC4F8\uB9CC\uD55C \uC7AC\uB8CC\uB4E4\uC744 \uCC3E\uC558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60501562048872448
    m_Localized: "\uAC74\uBB3C\uC774 \uBB34\uB108\uC838 \uB0B4\uB824 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uC5C8\uB2E4The building collapsed and sustained damage.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 60510599570227200
    m_Localized: "\uBA54\uC778\uBA54\uB274\uB85C \uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 60510621091201024
    m_Localized: "\uC885\uB8CC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 60513535033573376
    m_Localized: "\uAC8C\uC784\uC744 \uC885\uB8CC\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uD604\uC7AC
      \uC0C1\uD669\uC774 \uC800\uC7A5\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 60514019773480960
    m_Localized: "\uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 60616078195654656
    m_Localized: "\uC18D\uB3C4 +2\t"
    m_Metadata:
      m_Items: []
  - m_Id: 60616090967310336
    m_Localized: "\uACF5\uACA9\uB825 + 5"
    m_Metadata:
      m_Items: []
  - m_Id: 60616092401762304
    m_Localized: "\uCD5C\uB300\uCCB4\uB825 + 5"
    m_Metadata:
      m_Items: []
  - m_Id: 60616235003904000
    m_Localized: "\uAE30\uCCB4\uB97C \uC53B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60616236727762944
    m_Localized: "\uB5A0\uB09C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60616699497906176
    m_Localized: "\uB354\uB7EC\uC6B4 \uBB3C\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60616597412741120
    m_Localized: "\uBD84\uC218\uAC00 \uC788\uB2E4 \uAE30\uCCB4\uB97C \uC53B\uC744
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 60664080838918144
    m_Localized: "\uD754\uB4E4\uB9BC\uC744 \uC904\uC5EC \uC815\uD655\uB3C4\uB97C
      \uB192\uC785\uB2C8\uB2E4.\n\uC815\uD655\uB3C4 +5"
    m_Metadata:
      m_Items: []
  - m_Id: 60664083732987904
    m_Localized: "\uC7A5\uAC11\uC744 \uC7A5\uCC29\uD574 \uCD5C\uB300\uCCB4\uB825\uC744
      \uB298\uB9BD\uB2C8\uB2E4.\n\uCD5C\uB300\uCCB4\uB825 + 10"
    m_Metadata:
      m_Items: []
  - m_Id: 60664084936753152
    m_Localized: "\uBB34\uAE30\uC5D0 \uBD80\uC2A4\uD130\uB97C \uC7A5\uCC29\uD574
      \uACF5\uACA9\uB825\uC744 \uB192\uC785\uB2C8\uB2E4.\n\uACF5\uACA9\uB825 + 5"
    m_Metadata:
      m_Items: []
  - m_Id: 60666799339307008
    m_Localized: "\uACE0\uC815\uB300"
    m_Metadata:
      m_Items: []
